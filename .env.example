# Copy to .env and fill in what you need. Everything except DATABASE_URL is optional.

# SQLite database file. Created by `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# --- Who can open the app --------------------------------------------------
# 127.0.0.1 (the default) means only this computer. There is NO LOGIN: setting
# HOST to 0.0.0.0 or your computer's network IP lets anyone on the same network
# see and change all of your financial data. Only change it on a network you
# trust, and never on public Wi-Fi.
HOST=127.0.0.1
PORT=3000

# --- Bank sync (optional) ---------------------------------------------------
# Without these, add accounts manually and import transactions from CSV.
# Get keys at https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production. Production links count against Plaid's trial Item limit permanently.
PLAID_ENV=sandbox
# Countries whose banks to offer, comma-separated (US, CA, GB, ... as Plaid supports). Defaults to US.
PLAID_COUNTRY_CODES=US
# Encrypts stored Plaid access tokens: 64 hex characters. Generate with `openssl rand -hex 32`.
# Keep it safe: losing it means re-linking every bank.
PLAID_TOKEN_KEY=

# --- AI assistant (optional) -----------------------------------------------
# Enables the Chat page. Pick ONE provider. The figures needed to answer each
# question are sent to that provider, except with Ollama or LM Studio, which run
# on this computer so nothing leaves it. Usage is billed by the provider.
#
#   anthropic   ANTHROPIC_API_KEY (LLM_MODEL optional)
#   openai      OPENAI_API_KEY + LLM_MODEL
#   gemini      GEMINI_API_KEY + LLM_MODEL
#   openrouter  OPENROUTER_API_KEY + LLM_MODEL
#   ollama      LLM_MODEL (a model you've pulled, e.g. as listed by `ollama list`)
#   lmstudio    LLM_MODEL (the model loaded in LM Studio's server)
#   custom      LLM_BASE_URL (ending in /v1) + LLM_MODEL, and LLM_API_KEY if it needs one
#
# Without LLM_PROVIDER, whichever of the API keys below is set is used.
# Pick a model that supports tool (function) calling; the assistant needs it.
LLM_PROVIDER=
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=

# --- Backups (optional) -----------------------------------------------------
# Folder for daily database backups, e.g. one synced to cloud storage. Defaults to ./backups.
BACKUP_DIR=
